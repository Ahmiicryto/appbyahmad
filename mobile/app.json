{
  "expo": {
    "name": "AppByAhmad",
    "slug": "appbyahmad",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.htec.appbyahmad"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0E15",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.htec.appbyahmad"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "scheme": "appbyahmad",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "AppByAhmad uses your photos so you can choose a profile picture.",
          "cameraPermission": "AppByAhmad uses the camera so you can take a profile picture.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://appbyahmad-production.up.railway.app"
    }
  }
}
