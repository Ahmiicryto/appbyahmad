{
  "expo": {
    "name": "Elauxi",
    "slug": "elauxi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.htec.elauxi",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#040212",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.htec.elauxi"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Elauxi",
      "shortName": "Elauxi",
      "themeColor": "#040212",
      "description": "Your Everyday Superpower."
    },
    "scheme": "elauxi",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "AppByAhmad uses your photos so you can choose a profile picture.",
          "cameraPermission": "AppByAhmad uses the camera so you can take a profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#040212"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://appbyahmad-production.up.railway.app"
    },
    "description": "Elauxi — Your Everyday Superpower. Goals, daily plans, journal and an AI coach in one app.",
    "backgroundColor": "#040212"
  }
}
