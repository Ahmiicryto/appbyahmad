# Copy to .env for local development. On Render these are set by render.yaml / the dashboard.
DATABASE_URL=postgres://app@127.0.0.1:5433/lifeos
PORT=3000

# Random text, 32+ characters each. Never commit real values.
JWT_SECRET=change-me
# Any random text of 32+ characters (a long passphrase is fine).
# Encrypts journal entries. Never change it after real data exists.
ENCRYPTION_KEY=

# First admin account, created on boot (password must be 12+ characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI goal plans. Leave empty to use the built-in template planner.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Web origins allowed to call the API from a browser (the phone app doesn't need this).
CORS_ORIGINS=

ALLOW_SIGNUP=true
FREE_ACTIVE_GOALS=1
FREE_AI_PLANS_PER_MONTH=3
